# Copy to .env and fill in. .env is gitignored — never commit it.

POSTGRES_DB=im_master
POSTGRES_USER=im_master
POSTGRES_PASSWORD=

# Host port for the web container. 8082 = wholesale-order-entry,
# 8083 = ymal-project, so this stack uses 8084.
IM_MASTER_WEB_PORT=8084

# Backend port on the host, for `npm run dev`. 8080 is taken by
# ppic-order-export on this machine.
IM_MASTER_API_PORT=8085

# Uploads
MAX_UPLOAD_MB=8
