# Copy to .env and fill in. .env is gitignored — never commit it.

POSTGRES_DB=im_master
POSTGRES_USER=im_master
POSTGRES_PASSWORD=

# Host port for the web container. 8082 = wholesale-order-entry,
# 8083 = ymal-project, so this stack uses 8084.
IM_MASTER_WEB_PORT=8086

# Backend port on the host, for `npm run dev`. 8080 is taken by
# ppic-order-export on this machine.
IM_MASTER_API_PORT=8085

# --- Who may change things -------------------------------------------------
# One password for the team. Checked on the server and never sent to the
# browser; the browser gets a token signed with it, so changing this signs
# everyone out. Change it before this is reachable from outside.
APP_PASSWORD=operator123
# How long a session lasts before the password is asked for again.
SESSION_HOURS=12

# Puts a red DEVELOPMENT band across every page. Set by
# docker-compose.dev.yml; leave it false — or absent — on the VM.
APP_DEV=false

# Uploads
MAX_UPLOAD_MB=8

# --- Sales Report: Salesforce + Shopify ---------------------------------
# The sales history sheet fetches from both. Copy these from
# web-apps/services/.env — they live in two projects now, so rotating one
# without the other breaks that run.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SHOPIFY_STORE=
SHOPIFY_API_VERSION=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Where the refreshed Shopify token is cached. Make it an absolute path, or a
# path inside the backend container — a relative one resolves against the
# working directory and will not be the file web-apps writes.
TOKEN_PATH=
